DJANGO_SETTINGS_MODULE=wismo.settings_dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_APP_NAME=wismo_app
DB_APP_USER=wismo
DB_APP_PASSWORD=
DB_APP_HOST=127.0.0.1
DB_APP_PORT=5432

DB_VECTOR_NAME=wismo_vector
DB_VECTOR_USER=wismo
DB_VECTOR_PASSWORD=
DB_VECTOR_HOST=127.0.0.1
DB_VECTOR_PORT=5433

# Email (OTP verification)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@wismo.app

# OTP settings
WISMO_OTP_LENGTH=6
WISMO_OTP_TTL_MINUTES=30
WISMO_OTP_RESEND_COOLDOWN_SECONDS=60
WISMO_OTP_RESEND_CAP=5
WISMO_OTP_EMAIL_SUBJECT=Your WISMO verification code

# Google OAuth
WISMO_GOOGLE_CLIENT_ID=

# Retrieval embedding (Step 9 local fallback path)
WISMO_EMBEDDING_ENDPOINT=http://127.0.0.1:8001/embed
WISMO_EMBEDDING_MODEL=BAAI/bge-m3
WISMO_EMBEDDING_TIMEOUT_MS=2000

# Retrieval reranker (Step 9)
WISMO_RERANKER_ENABLED=true
WISMO_RERANKER_ENDPOINT=http://127.0.0.1:8002/rerank
WISMO_RERANKER_MODEL=bge-reranker-v2-m3
WISMO_RERANKER_TIMEOUT_MS=2000
